# Claude API — структуризация спецификации, разбор писем, матчинг наименований
ANTHROPIC_API_KEY=

# Модели: opus для качества матчинга, sonnet для массовых дешёвых операций
MODEL_SMART=claude-opus-4-8
MODEL_FAST=claude-sonnet-4-6

# DaData — реквизиты организации по ИНН (наименование, КПП, адрес)
DADATA_TOKEN=

# (Опц.) Yandex Search API; пусто => поиск через браузер Playwright
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# Параметры поиска цен
MIN_SOURCES=12          # минимум источников на позицию
TOP_PRICES=3            # сколько максимальных цен берём в КАЦ/ТКП
VAT_RATE=22             # НДС, %
REGION=Москва и Московская область

# производители уникального оборудования (цена из писем, онлайн-поиск не нужен), через «;»
CUSTOM_MAKERS=

# Браузер: headed=true показывает окно (надёжнее против антибота)
BROWSER_HEADED=true

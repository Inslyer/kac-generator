#!/bin/bash
# Запуск движка двойным кликом из Finder (macOS).
# Использует уже установленное окружение (engine/.venv) — без переустановки зависимостей,
# поэтому стартует за пару секунд и не зависает. Движок идёт в вашей графической сессии,
# поэтому окно браузера во время поиска видно на экране.
cd "$(dirname "$0")"

if [ ! -x engine/.venv/bin/python ]; then
  echo "Окружение не найдено (engine/.venv). Сначала выполните установку — см. docs/INSTRUCTION.md"
  echo "Нажмите Enter для выхода…"; read; exit 1
fi

# через 3 сек откроем интерфейс в браузере
( sleep 3 && open "http://127.0.0.1:8765/" ) &

echo "Движок запускается на http://127.0.0.1:8765/"
echo "Это окно не закрывайте. Для остановки — Ctrl+C."
exec ./engine/.venv/bin/python -m uvicorn engine.app:app --host 127.0.0.1 --port 8765
